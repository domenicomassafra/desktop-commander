[Unit]
Description=Owner Desktop Commander Cloudflare Tunnel
Wants=network-online.target desktop-commander.service
After=network-online.target desktop-commander.service

[Service]
Type=simple
ExecStart=/usr/local/bin/cloudflared tunnel --no-autoupdate --protocol quic run --token-file %h/.config/desktop-commander/tunnel.token
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
MemoryMax=192M
TasksMax=48

[Install]
WantedBy=default.target
