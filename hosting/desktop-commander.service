[Unit]
Description=Desktop Commander private OpenAI MCP tunnel
After=network-online.target

[Service]
ExecStart=%h/.local/opt/desktop-commander/tunnel-client-0.0.18/tunnel-client run --profile computer-mcp --profile-dir %h/.config/desktop-commander/tunnel-profiles
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
UMask=0077
MemoryMax=1G
TasksMax=128

[Install]
WantedBy=default.target
